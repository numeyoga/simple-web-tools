{
  "name": "locavern",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first personal productivity web application (projects, tasks, Kanban, rich-text notes, SVG whiteboard)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/numeyoga/simple-web-tools.git",
    "directory": "apps/locavern"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@simple-web-tools/covenant": "*",
    "@simple-web-tools/dates": "*",
    "@simple-web-tools/i18n": "*",
    "@simple-web-tools/rich-text": "*",
    "@simple-web-tools/storage": "*",
    "@simple-web-tools/suite": "*",
    "fflate": "^0.8.3",
    "idb": "^8.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@simple-web-tools/config": "*",
    "@simple-web-tools/pwa": "*",
    "@simple-web-tools/test-utils": "*",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
